rules_version = '2';

// TEMPORARY: all reads open to any signed-in user; writes server-only.
// TODO: restore privacy model (phones, payments, cross-group isolation)
// before real members are onboarded. Last privacy version is in git history
// and /tmp/rules-backup locally.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false; // all mutations go through Callable Functions
    }
  }
}
