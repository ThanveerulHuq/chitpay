{
  "firestore": {
    "database": "chitpay",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "app/dist",
    "ignore": ["firebase.json", "manifest.webmanifest", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/manifest.webmanifest",
        "function": {
          "functionId": "providerBranding",
          "region": "asia-south1"
        }
      },
      {
        "source": "/provider-branding/**",
        "function": {
          "functionId": "providerBranding",
          "region": "asia-south1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
